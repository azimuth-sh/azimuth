    "test": "npm run build && node tests/integration.cjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "homepage": "https://azimuth.sh"
