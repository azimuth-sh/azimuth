{
  "name": "@azimuth-sh/emit",
  "version": "0.1.0-alpha.4",
  "description": "Static-scan emitter: TypeScript linkage tags to the Azimuth manifest.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "files": [
    "dist/cli.js",
    "dist/emitter.js",
    "dist/prometheus.js",
    "dist/workspace.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azimuth-sh/azimuth.git",
    "directory": "tools/extractors/typescript"
  },
  "homepage": "https://azimuth.sh",
  "publishConfig": { "access": "public" },
  "bin": {
    "azimuth-emit-ts": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": { "typescript": "^5.9.3" },
  "devDependencies": { "@types/node": "^22.10.0" }
}
