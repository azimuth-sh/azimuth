{
  "name": "@azimuth-sh/emit",
  "version": "0.1.0-alpha.1",
  "description": "Static-scan emitter: TypeScript linkage tags to the Azimuth manifest.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "files": [
    "dist/cli.js",
    "dist/emitter.js",
    "dist/manual-cli.js",
    "dist/manual-results.js",
    "dist/mutation-cli.js",
    "dist/mutation-results.js",
    "dist/observation-cli.js",
    "dist/observations.js",
    "dist/pit-cli.js",
    "dist/pit-results.js",
    "dist/pit-xml.js",
    "dist/prometheus.js",
    "dist/sarif-cli.js",
    "dist/sarif-results.js",
    "dist/workspace.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azimuth-sh/azimuth.git",
    "directory": "tools/extractors/typescript"
  },
  "homepage": "https://azimuth.sh",
  "publishConfig": { "access": "public" },
  "bin": {
    "azimuth-emit-ts": "dist/cli.js",
