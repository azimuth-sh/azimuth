    "azimuth-import-observation": "dist/observation-cli.js",
    "azimuth-import-pit": "dist/pit-cli.js",
    "azimuth-import-sarif": "dist/sarif-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test dist/*.test.js"
