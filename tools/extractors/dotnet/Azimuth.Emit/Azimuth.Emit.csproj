<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>azimuth-emit-dotnet</AssemblyName>
    <RootNamespace>Azimuth.Emit</RootNamespace>
    <PackageId>Azimuth.Emit</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Extracts Azimuth linkage tags from compiled .NET assemblies.</Description>
    <PackageProjectUrl>https://azimuth.sh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/azimuth-sh/azimuth</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>requirements;traceability;extractor;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>azimuth-emit-dotnet</ToolCommandName>
  </PropertyGroup>

  <!-- D17 constrains the core, not the extractors. AST and metadata work belongs here, in an
       ecosystem where the tooling is already present and idiomatic. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="../../../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Azimuth.Emit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
