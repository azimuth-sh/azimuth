<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>azimuth-emit-dotnet</AssemblyName>
    <RootNamespace>Azimuth.Emit</RootNamespace>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- D17 constrains the core, not the extractors. AST and metadata work belongs here, in an
       ecosystem where the tooling is already present and idiomatic. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Azimuth.Emit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
