<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Azimuth.Manifest</AssemblyName>
    <RootNamespace>Azimuth.Manifest</RootNamespace>
  </PropertyGroup>

  <!-- Reflecting over an ASP.NET Core assembly (e.g. DrimDev.Api) resolves shared-framework
       types (Microsoft.Extensions.Hosting.Abstractions, …) when the collector reads a type's
       namespace. Host the ASP.NET Core runtime so those resolve instead of throwing. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Azimuth.Annotations\Azimuth.Annotations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.0" />
  </ItemGroup>

</Project>
