<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Azimuth.Context</AssemblyName>
    <RootNamespace>Azimuth.Context</RootNamespace>
    <PackageId>Azimuth.Context</PackageId>
    <Description>Applies an execution context's values to a component and reports them.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
  </ItemGroup>

</Project>
