<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Azimuth.Context</AssemblyName>
    <RootNamespace>Azimuth.Context</RootNamespace>
    <PackageId>Azimuth.Context</PackageId>
    <Description>Applies an execution context's values to a component and reports them.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A published version cannot be changed, so the package names where it comes from. -->
    <Authors>Azimuth</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://azimuth.sh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/azimuth-sh/azimuth</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
