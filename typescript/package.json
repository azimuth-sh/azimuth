{
  "name": "@azimuth/annotations",
  "version": "0.1.0",
  "description": "Azimuth linkage markers (realizes/covers) for TypeScript, plus a static-scan manifest emitter for rtm.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "azimuth-emit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
