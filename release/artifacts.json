{
  "format": "azimuth-release-artifacts",
  "schemaVersion": 1,
  "release": {
    "version": "0.1.0-alpha.7",
    "tag": "v0.1.0-alpha.7",
    "migrationLine": "alpha-requirement-scenario",
    "license": "Apache-2.0",
    "repository": "https://github.com/azimuth-sh/azimuth",
    "homepage": "https://azimuth.sh"
  },
  "packages": [
    {
      "id": "rust-cli-core",
      "ecosystem": "cargo",
      "identity": "azimuth",
      "manifest": "tools/azimuth/Cargo.toml",
      "requiredFiles": [
        "*/src/lib.rs",
        "*/src/main.rs",
        "*/resources/manifest.json",
        "*/resources/skills/azimuth-maintain/SKILL.md",
        "*/resources/references/intent-delta.md",
        "*/README.md",
        "*/LICENSE"
      ],
      "allowedFiles": [
        "*/.cargo_vcs_info.json",
        "*/Cargo.lock",
        "*/Cargo.toml",
        "*/Cargo.toml.orig",
        "*/LICENSE",
        "*/README.md",
        "*/resources/*",
        "*/resources/*/*",
        "*/resources/*/*/*",
        "*/src/*.rs"
      ]
    },
    {
      "id": "dotnet-annotations",
      "ecosystem": "nuget",
      "identity": "Azimuth.Annotations",
      "manifest": "packages/dotnet/Azimuth.Annotations/Azimuth.Annotations.csproj",
      "requiredFiles": [
        "*.nuspec",
        "README.md",
        "lib/netstandard2.0/Azimuth.Annotations.dll"
      ],
      "allowedFiles": [
        "[Content_Types].xml",
        "_rels/.rels",
        "*.nuspec",
        "README.md",
        "lib/netstandard2.0/Azimuth.Annotations.dll",
        "lib/netstandard2.0/Azimuth.Annotations.xml",
        "package/services/metadata/core-properties/*.psmdcp"
      ]
    },
    {
      "id": "dotnet-emitter",
      "ecosystem": "nuget",
      "identity": "Azimuth.Emit",
      "manifest": "tools/extractors/dotnet/Azimuth.Emit/Azimuth.Emit.csproj",
      "requiredFiles": [
        "*.nuspec",
        "README.md",
        "tools/net10.0/any/azimuth-emit-dotnet.dll"
      ],
      "allowedFiles": [
        "[Content_Types].xml",
        "_rels/.rels",
        "*.nuspec",
        "README.md",
        "package/services/metadata/core-properties/*.psmdcp",
        "tools/net10.0/any/*"
      ]
    },
    {
      "id": "typescript-annotations",
      "ecosystem": "npm",
      "identity": "@azimuth-sh/annotations",
      "manifest": "packages/typescript/package.json",
      "requiredFiles": [
        "package/package.json",
        "package/dist/index.js",
        "package/dist/index.d.ts"
      ],
      "allowedFiles": [
        "package/package.json",
        "package/dist/index.js",
        "package/dist/index.d.ts"
      ]
    },
    {
      "id": "typescript-emitter",
      "ecosystem": "npm",
      "identity": "@azimuth-sh/emit",
      "manifest": "tools/extractors/typescript/package.json",
      "requiredFiles": [
        "package/package.json",
        "package/dist/cli.js",
        "package/dist/emitter.js"
      ],
      "allowedFiles": [
        "package/package.json",
        "package/dist/*.js"
      ]
    },
    {
      "id": "dotnet-testing-xunit",
      "ecosystem": "nuget",
      "identity": "Azimuth.Testing.Xunit",
      "manifest": "packages/dotnet/Azimuth.Testing.Xunit/Azimuth.Testing.Xunit.csproj",
      "requiredFiles": [
        "*.nuspec",
        "README.md",
        "lib/net8.0/Azimuth.Testing.Xunit.dll"
      ],
      "allowedFiles": [
        "[Content_Types].xml",
        "_rels/.rels",
        "*.nuspec",
        "README.md",
        "lib/net8.0/Azimuth.Testing.Xunit.dll",
        "package/services/metadata/core-properties/*.psmdcp"
      ]
    },
    {
      "id": "typescript-playwright",
      "ecosystem": "npm",
      "identity": "@azimuth-sh/playwright",
      "manifest": "packages/typescript-playwright/package.json",
      "requiredFiles": [
        "package/package.json",
        "package/dist/index.js",
        "package/dist/index.d.ts",
        "package/dist/reporter.js"
      ],
      "allowedFiles": [
        "package/package.json",
        "package/README.md",
        "package/dist/*.js",
        "package/dist/*.d.ts"
      ]
    }
  ],
  "images": [
    {
      "id": "assurance-api",
      "identity": "ghcr.io/azimuth-sh/azimuth-assurance-api",
      "context": ".",
      "dockerfile": "services/assurance/server/Dockerfile",
      "versionManifest": "services/assurance/Cargo.toml",
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ]
    },
    {
      "id": "assurance-web",
      "identity": "ghcr.io/azimuth-sh/azimuth-assurance-web",
      "context": "services/assurance/web",
      "dockerfile": "services/assurance/web/Dockerfile",
      "versionManifest": "services/assurance/web/package.json",
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ]
    }
  ],
  "nativeBinaries": {
    "identity": "azimuth",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "resources": {
    "format": "azimuth-cli-resources",
    "manifest": "tools/azimuth/resources/manifest.json",
    "package": "rust-cli-core"
  },
  "protocols": [
    {
      "id": "model-export",
      "version": 8,
      "produces": true,
      "accepts": true
    },
    {
      "id": "adapter-config",
      "version": 1,
      "produces": false,
      "accepts": true
    },
    {
      "id": "run-bundle",
      "version": 2,
      "produces": true,
      "accepts": true
    },
    {
      "id": "run-launch-plan",
      "version": 2,
      "produces": true,
      "accepts": true
    },
    {
      "id": "workspace",
      "version": 2,
      "produces": true,
      "accepts": true
    },
    {
      "id": "installation",
      "version": 1,
      "produces": true,
      "accepts": true
    },
    {
      "id": "migration-plan",
      "version": 2,
      "produces": true,
      "accepts": true
    },
    {
      "id": "execution-context",
      "version": 2,
      "produces": true,
      "accepts": true
    },
    {
      "id": "test-report",
      "version": 1,
      "produces": true,
      "accepts": true
    },
    {
      "id": "test-mapping",
      "version": 2,
      "produces": false,
      "accepts": true
    },
    {
      "id": "native-test-results",
      "version": 1,
      "produces": false,
      "accepts": true
    },
    {
      "id": "deployment-assessment",
      "version": 2,
      "produces": false,
      "accepts": true
    },
    {
      "id": "deployment-status",
      "version": 2,
      "produces": true,
      "accepts": true
    }
  ],
  "supportedSurfaces": [
    "rust-cli-core",
    "dotnet-integration",
    "typescript-integration",
    "assurance-reference",
    "repository-contracts",
    "consumer-installation"
  ],
  "experimentalSource": [
    "experiments",
    "packages/cpp",
    "packages/go",
    "packages/jvm",
    "packages/python",
    "packages/rust",
    "tools/extractors/cpp",
    "tools/extractors/go",
    "tools/extractors/helm",
    "tools/extractors/jvm",
    "tools/extractors/python",
    "tools/extractors/rust"
  ]
}
